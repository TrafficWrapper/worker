# Release tag of prebuilt images from ghcr.io/trafficwrapper/worker-* (e.g. v1.2.3).
# Empty = build locally (images tagged :local). With a tag set, use
# `docker compose pull && docker compose up -d --no-build`.
WORKER_VERSION=

# Public ports exposed by this worker. install.sh picks 443 for REALITY when
# it is free and otherwise random high ports, so deployments do not share a
# recognizable port; an installed worker keeps its ports on re-runs.
XRAY_PORT=
AWG_PORT=
AGENT_PORT=9090
# Extra sources allowed to read /self-describe and /metrics besides loopback and
# the published host port, e.g. a Prometheus container on the Compose network.
AGENT_API_ALLOW_CIDRS=

# AWG addressing inside the worker data plane.
AWG_SUBNET=10.13.13.0/24
AWG_GATEWAY=10.13.13.1
# Server-side AWG peer keepalive policy. Change and restart agent + awg-gw
# together for an emergency rollback; clients keep their independent policy.
AWG_SERVER_KEEPALIVE=0

# Orchestrator enrollment and pinning.
# Same-host Docker: use https://host.docker.internal:9091.
# Remote ORCH: use its public ORCH_PUBLIC_URL.
ORCH_URL=
ORCH_STATIC_PUBLIC_KEY=
# Required for the default self-signed ORCH_TLS=1. Keep 0 with real production TLS.
ORCH_INSECURE_TLS=0
ENROLL_TOKEN=
# How often the agent acks applied config to the orchestrator (10s..1h).
ORCH_ACK_INTERVAL=90s

# Public worker identity advertised to clients.
PUBLIC_ADDRESS=
# Global IPv6 of the host advertised to clients (or "auto").
PUBLIC_ADDRESS_V6=
# In-tunnel DNS resolver: start the "dns" compose profile and set 1.
WORKER_DNS=0
DNS_UPSTREAMS="https://dns.quad9.net/dns-query https://cloudflare-dns.com/dns-query"
DNS_BOOTSTRAP=9.9.9.9:53
# Explicit public egress IP. If empty, the agent probes public echo-IP services.
EGRESS_IP=
CAPACITY=32

# In-tunnel distributor and agent endpoints.
DISTRIBUTOR_URL=http://awg-gw:8080/tw
WORKER_AGENT_URL=

# REALITY camouflage and upstream destination.
# Required: set a real TLS 1.3 SNI/fallback domain. The agent refuses empty
# values and public placeholders such as example.com/example.org.
CAMOUFLAGE_DOMAIN=
# Empty means CAMOUFLAGE_DOMAIN:443, so probes see the real site. The internal
# self-signed fallback awg-gw:9443 is easy to fingerprint; use it only for tests.
REALITY_DEST=
XRAY_NETWORK=tcp
XRAY_XHTTP_PATH=
XRAY_XHTTP_MODE=
XRAY_XHTTP_HOST=
XRAY_XHTTP_EXTRA_JSON=
# Extra REALITY inbounds (fallback profiles), JSON list, e.g.
# [{"name":"xh","network":"xhttp","listen_port":8444,"public_port":2083,"xhttp_path":"/x","xhttp_mode":"auto"}]
# Publish each listen_port in docker-compose.override.yml (see README).
REALITY_INBOUNDS=
# AWG profiles, JSON list; empty means one base profile from AWG_PORT and
# AWG_SUBNET. min_version_code is the code derived from the app version name,
# major*10000+minor*100+patch (0.1.31 -> 131), not the Android versionCode.
# See ARCHITECTURE.md for dialect rotation.
AWG_INBOUNDS=
# Seconds a client's REALITY handshake time may differ from the worker's; a
# recorded ClientHello cannot be replayed after that. 0 turns the check off.
REALITY_MAX_TIME_DIFF=120

# Interface install.sh reads EGRESS_IP from when public lookups disagree.
WAN_IF=
EGRESS_VIA_WG=

# Client isolation. By default clients cannot reach private, loopback,
# link-local (cloud metadata) or Docker-internal addresses through the worker.
WORKER_ALLOW_PRIVATE_EGRESS=0
# Abuse protection: block outbound SMTP (25/465/587) and BitTorrent.
WORKER_BLOCK_SMTP=1
WORKER_BLOCK_BITTORRENT=1
# Where the agent probes its own REALITY listener (censor-style, no key).
REALITY_PROBE_ADDR=xray:8443
# Built-in smoke credentials (p0-smoke REALITY user and AWG smoke peer).
# Empty: enabled in standalone mode, disabled when ORCH_URL is set.
WORKER_SMOKE_PEERS=

# Optional local state and docker integration overrides.
WORKER_STATE_DIR=/worker-state
AWG_UAPI_SOCKET=/var/run/wireguard/awg1.sock
XRAY_API_SOCKET=/run/xray-api/api.sock

# Logging: LOG_LEVEL for the agent (debug|info|warn|error),
# AWG_LOG_LEVEL for awg-gw (verbose|error|silent).
LOG_LEVEL=info
AWG_LOG_LEVEL=error

# Metrics privacy. AWG peer public keys are replaced with salted hashes and the
# allowed IP and endpoint labels are dropped. 1 exports them raw (keep metrics
# on the host then). Empty salt: generated once and kept in
# worker-state/metrics_salt.
TW_METRICS_RAW_PEER_LABELS=0
TW_METRICS_SCRUB_SALT=

# Wide AWG junk-packet ranges for newly generated dialects; enable only when
# every client accepts them.
WORKER_DIALECT_WIDE=0

# Optional advanced dialect override. JSON must match the worker dialect schema.
TW_WORKER_DIALECT_JSON=

# Optional awg-gw stub/debug variables.
SERVICE_NAME=awg-gw
AWG_LISTEN_UDP=51821

# Optional awg-smoke profile overrides.
AWG_ENDPOINT=host.docker.internal:51888
TW_SMOKE_URL=http://10.13.13.1:8080/tw/config.json
AWG_CLIENT_PRIVATE_KEY=
AWG_CLIENT_PSK=
AWG_CLIENT_IP=

# Optional install.sh controls.
COMPOSE="docker compose"
# Empty: 443 or a random port in 20000-59999 (REALITY), a random port
# (AWG). Set a quoted space-separated list to choose from fixed ports.
REALITY_PORT_POOL=
AWG_PORT_POOL=
